# ═══════════════════════════════════════════════════
# TAREA FÁCIL — Variables de Entorno (PLANTILLA)
# Copiar a .env y rellenar con valores reales
# ═══════════════════════════════════════════════════

# Variables Generales
PORT=3000
FRONTEND_URL=http://localhost:4200
NODE_ENV=development

# Base de datos (TiDB Cloud o MySQL local)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=4000
DB_SSL=true

# CA Certificado SSL (opcional, para TiDB Cloud)
# Puede ser un path a archivo .pem o contenido PEM directo
# DB_SSL_CA=

# Seguridad
JWT_SECRET=
